# Cognee Cloud: https://platform.cognee.ai/sign-up → API Keys
COGNEE_API_KEY=
# Tenant URL from the same page. Include https://
COGNEE_BASE_URL=
COGNEE_USER_ID=
COGNEE_TENANT_ID=
COGNEE_DATASET=
# Scalekit: https://app.scalekit.com → Developers → Settings → API Credentials
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SCALEKIT_REDIRECT_URI=http://localhost:5001/callback
# openssl rand -base64 32
COOKIE_ENCRYPTION_SECRET=
# Optional if the access token has no email:
# SCALEKIT_ALICE_SUB=usr_...
# SCALEKIT_BOB_SUB=usr_...
SLACK_CONNECTION_NAME=slack
# Slack channel name without #. Example: general
SLACK_CHANNEL=

